<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <FleckDef ParentName="FleckBase_Thrown">
    <defName>RK_DeliveryBox_BreakthroughAttackFleck</defName>
    <altitudeLayer>MoteOverhead</altitudeLayer>
    <fadeInTime>0.01</fadeInTime>
    <solidTime>0.1</solidTime>
    <fadeOutTime>0.2</fadeOutTime>
    <graphicData>
      <texPath>VFX/Breakthrough_AttackEffect</texPath>
      <shaderType>MoteGlow</shaderType>
      <drawSize>1.2</drawSize>
      <graphicClass>Graphic_Fleck</graphicClass>
    </graphicData>
  </FleckDef>

  <EffecterDef>
    <defName>RK_DeliveryBox_BreakthroughAttack</defName>
    <children>
      <li>
        <subEffecterClass>SubEffecter_SprayerTriggered</subEffecterClass>
        <fleckDef>RK_DeliveryBox_BreakthroughAttackFleck</fleckDef>
        <burstCount>1</burstCount>
        <scale>1.0~1.0</scale>
        <spawnLocType>OnSource</spawnLocType>
        <!-- 朝向按 A(施放者) -> B(本次挥击的目标格) 的真实方向计算:关闭 useTargetAInitialRotation 后
             num = (B.Cell - A.Cell).AngleFlat;rotation 的 -90 用于修正「冲击端朝东」的贴图基准,
             两者相加后冲击端指向目标。perRotationOffsets 的索引是 Rot4.AsInt(仅 0~3 四值),只能表达四向,故不使用。 -->
        <rotation>-90~-90</rotation>
      </li>
    </children>
    <!-- 沿 A->B 推出 0.9,把贴图中心落到目标身上。本字段属于 EffecterDef,必须与 children 同级;
         写进子效果器不会生效(SubEffecterDef 无此字段)。 -->
    <offsetTowardsTarget>0.9~0.9</offsetTowardsTarget>
  </EffecterDef>
</Defs>
