<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <!-- 二协会双手剑 -->
  <ThingDef ParentName="RK_MeleeWeapon">
    <defName>zweiC</defName>
    <label>南部Zwei协会双手剑</label>
    <description>南部Zwei协会收尾人们使用等身高的双手大剑。巨大的武器是其特征，能让使用者更好地做到防御。</description>
    <graphicData>
      <texPath>Weapon/zweiC</texPath>
      <graphicClass>Graphic_Single</graphicClass>
    </graphicData>
    <techLevel>Medieval</techLevel>
    <weaponTags Inherit="false">
      <li>RK_Sword</li>
      <li>RK_Knight</li>
      <li>RK_WeaponTag_TwoHand</li>
      <li>RK_WeaponTag_TwoHandMelee</li>
      <li>RK_WeaponTag_TwoHandMeleeAttack</li>
      <li>RK_WeaponTag_ArmedWanderer</li>
    </weaponTags>
    <statBases>
      <WorkToMake>20000</WorkToMake>
      <Mass>2</Mass>
    </statBases>
    <equippedAngleOffset>220</equippedAngleOffset>
    <stuffCategories>
      <li>Metallic</li>
      <li>Woody</li>
    </stuffCategories>
    <costStuffCount>140</costStuffCount>
    <tools>
      <li>
        <label>剑柄</label>
        <capacities>
          <li>Blunt</li>
        </capacities>
        <power>9</power>
        <armorPenetration>0.14</armorPenetration>
        <cooldownTime>2.0</cooldownTime>
      </li>
      <li>
        <label>剑尖</label>
        <capacities>
          <li>Stab</li>
        </capacities>
        <power>16</power>
        <armorPenetration>0.40</armorPenetration>
        <cooldownTime>2.3</cooldownTime>
      </li>
      <li>
        <label>剑刃</label>
        <capacities>
          <li>Cut</li>
        </capacities>
        <power>23</power>
        <armorPenetration>0.35</armorPenetration>
        <cooldownTime>2.5</cooldownTime>
      </li>
    </tools>
    <recipeMaker>
      <researchPrerequisite>RK_Research_SwordAndShield</researchPrerequisite>
      <skillRequirements>
        <Crafting>5</Crafting>
      </skillRequirements>
      <displayPriority>78270</displayPriority>
    </recipeMaker>
    <comps>
      <li Class="NewRatkin.CompProperties_WeaponGripType">
        <gripTypes>
          <li>TwoHand</li>
        </gripTypes>
      </li>
      <li Class="XIYUNTE.CompProperties_EquippedHediff">
        <hediffDef>zweiC_Defense</hediffDef>
      </li>
      <li Class="SYS.CompProperties_Sheath">
        <sheathOnlyGraphicData>
          <texPath>Weapon/zweiC_Sheath</texPath>
          <graphicClass>Graphic_Multi</graphicClass>
        </sheathOnlyGraphicData>
        <fullGraphicData>
          <texPath>Weapon/zweiC_Full</texPath>
          <graphicClass>Graphic_Multi</graphicClass>
        </fullGraphicData>
        <drawPosition>Side</drawPosition>
        <northOffset>
          <position>(0,-0.3,0.1)</position>
          <angle>150</angle>
        </northOffset>
        <southOffset>
          <position>(0,0,0.1)</position>
          <angle>150</angle>
        </southOffset>
        <eastOffset>
          <position>(-0.2,-0.3,0.1)</position>
          <angle>150</angle>
        </eastOffset>
        <westOffset>
          <position>(0.2,-0.3,0.1)</position>
          <angle>210</angle>
        </westOffset>
      </li>
      <!-- SYS手持四向参数：position=(X,Y,Z)，X正右负左，Y为绘制高度，Z正北负南。
           angle为绕Y轴旋转角（度），正值顺时针、负值逆时针；南/西向使用镜像网格。
           此分支用于征召待机手持，直接读取angle，不叠加equippedAngleOffset。 -->
      <li Class="SYS.CompProperties_WeaponExtention">
        <northOffset>
          <position>(0.3,0,-0.25)</position>
          <angle>240</angle>
        </northOffset>
        <eastOffset>
          <position>(-0.25,0,-0.15)</position>
          <angle>30</angle>
        </eastOffset>
        <southOffset>
          <position>(-0.3,0.3,-0.25)</position>
          <!-- 南向镜像手持逆时针旋转90度，使剑尖朝画面左侧、远离身体。 -->
          <angle>-240</angle>
        </southOffset>
        <westOffset>
          <position>(0.25,-0.3,-0.15)</position>
          <angle>-30</angle>
        </westOffset>
      </li>
    </comps>
  </ThingDef>
</Defs>
