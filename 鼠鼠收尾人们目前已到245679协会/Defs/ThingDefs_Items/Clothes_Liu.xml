<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <!-- 南部六协会西装：贴身层衣物，提供心灵敏感度与社交效果偏移，代号仍为 liuA 供套装判定使用。 -->
  <ThingDef ParentName="RK_ApparelMakeableBase">
    <defName>liuA</defName>
    <description>与外套一样，里面的西装也拥有金色的花纹。作为善于进行大规模作战的协会，协会内风气也是其乐融融的像一个大家庭一样，这也是支撑六协会能进行大规模作战的原因之一。</description>
    <label>南部六协会西装</label>
    <recipeMaker>
      <researchPrerequisite>RK_Research_AdvancedApparel</researchPrerequisite>
      <recipeUsers Inherit="false">
        <li>RK_ElectricTailoringBench</li>
        <li>RK_HandTailoringBench</li>
      </recipeUsers>
      <displayPriority>208</displayPriority>
    </recipeMaker>
    <graphicData>
      <texPath>Clothing/liuA</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <ignoreThingDrawColor>true</ignoreThingDrawColor>
    </graphicData>
    <costStuffCount>75</costStuffCount>
    <costList>
      <Gold>1</Gold>
    </costList>
    <stuffCategories>
      <li>Fabric</li>
      <li>Leathery</li>
    </stuffCategories>
    <thingCategories>
      <li>ApparelMisc</li>
    </thingCategories>
    <techLevel>Industrial</techLevel>
    <statBases>
      <MaxHitPoints>300</MaxHitPoints>
      <WorkToMake>5600</WorkToMake>
      <Mass>0.5</Mass>
      <!-- 固定护甲值；材料护甲贡献按材料系数缩放后叠加。 -->
      <ArmorRating_Blunt>0.10</ArmorRating_Blunt>
      <ArmorRating_Sharp>0.40</ArmorRating_Sharp>
      <ArmorRating_Heat>0.40</ArmorRating_Heat>
      <StuffEffectMultiplierArmor>0.20</StuffEffectMultiplierArmor>
      <StuffEffectMultiplierInsulation_Cold>0.40</StuffEffectMultiplierInsulation_Cold>
      <StuffEffectMultiplierInsulation_Heat>0.60</StuffEffectMultiplierInsulation_Heat>
      <Flammability>0.40</Flammability>
      <EquipDelay>3</EquipDelay>
    </statBases>
    <!-- 装备时属性偏移：心灵敏感度 -40%，社交效果 +16%。 -->
    <equippedStatOffsets>
      <PsychicSensitivity>-0.40</PsychicSensitivity>
      <SocialImpact>0.16</SocialImpact>
    </equippedStatOffsets>
    <apparel>
      <developmentalStageFilter>Adult</developmentalStageFilter>
      <bodyPartGroups>
        <li>Torso</li>
        <li>Neck</li>
        <li>Shoulders</li>
        <li>Arms</li>
        <li>Legs</li>
        <li>Hands</li>
        <li>Feet</li>
      </bodyPartGroups>
      <wornGraphicPath>Clothing/liuA</wornGraphicPath>
      <layers>
        <li>OnSkin</li>
      </layers>
      <tags>
        <li>IndustrialBasic</li>
      </tags>
      <defaultOutfitTags>
        <li>Worker</li>
        <li>Soldier</li>
        <li>Spacefarer</li>
      </defaultOutfitTags>
    </apparel>
    <colorGenerator Class="ColorGenerator_StandardApparel" />
    <tradeTags>
      <li>BasicClothing</li>
    </tradeTags>
    <!-- 套装件：装备/卸下时把 RK_LiuSet 的进度 +1 / -1。 -->
    <comps>
      <li Class="XIYUNTE.CompProperties_LiuPiece" />
    </comps>
  </ThingDef>

  <!-- 南部六协会外套：外套层衣物，提供心灵敏感度与社交效果偏移，代号仍为 liuB 供套装判定使用。 -->
  <ThingDef ParentName="RK_ApparelMakeableBase">
    <defName>liuB</defName>
    <description>带有金色花纹的红色外套，有较好的防利器能力和隔热能力，衣服上的金色花纹可以一定程度上抵御精神攻击。</description>
    <label>南部六协会外套</label>
    <possessionCount>1</possessionCount>
    <recipeMaker>
      <researchPrerequisite>RK_Research_AdvancedApparel</researchPrerequisite>
      <recipeUsers Inherit="false">
        <li>RK_ElectricTailoringBench</li>
        <li>RK_HandTailoringBench</li>
      </recipeUsers>
      <displayPriority>215</displayPriority>
    </recipeMaker>
    <graphicData>
      <texPath>Clothing/liuB</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <ignoreThingDrawColor>true</ignoreThingDrawColor>
      <drawSize>1.05</drawSize>
    </graphicData>
    <costStuffCount>85</costStuffCount>
    <costList>
      <Gold>2</Gold>
    </costList>
    <stuffCategories>
      <li>Fabric</li>
      <li>Leathery</li>
    </stuffCategories>
    <thingCategories>
      <li>ApparelMisc</li>
    </thingCategories>
    <techLevel>Industrial</techLevel>
    <statBases>
      <MaxHitPoints>300</MaxHitPoints>
      <WorkToMake>13600</WorkToMake>
      <Mass>0.5</Mass>
      <!-- 固定护甲值；材料护甲贡献按材料系数缩放后叠加。 -->
      <ArmorRating_Blunt>0.30</ArmorRating_Blunt>
      <ArmorRating_Sharp>0.60</ArmorRating_Sharp>
      <ArmorRating_Heat>0.40</ArmorRating_Heat>
      <StuffEffectMultiplierArmor>0.30</StuffEffectMultiplierArmor>
      <StuffEffectMultiplierInsulation_Cold>0.60</StuffEffectMultiplierInsulation_Cold>
      <StuffEffectMultiplierInsulation_Heat>2.60</StuffEffectMultiplierInsulation_Heat>
      <Flammability>0.40</Flammability>
      <EquipDelay>2.6</EquipDelay>
    </statBases>
    <!-- 装备时属性偏移：心灵敏感度 -60%，社交效果 +16%。 -->
    <equippedStatOffsets>
      <PsychicSensitivity>-0.60</PsychicSensitivity>
      <SocialImpact>0.16</SocialImpact>
    </equippedStatOffsets>
    <apparel>
      <drawData>
        <defaultData>
          <offset>(-0.002,0,0)</offset>
        </defaultData>
      </drawData>
      <developmentalStageFilter>Adult</developmentalStageFilter>
      <bodyPartGroups>
        <li>Torso</li>
        <li>Neck</li>
        <li>Shoulders</li>
        <li>Arms</li>
        <li>Legs</li>
      </bodyPartGroups>
      <wornGraphicPath>Clothing/liuB</wornGraphicPath>
      <layers>
        <li>Shell</li>
      </layers>
      <tags>
        <li>IndustrialAdvanced</li>
      </tags>
      <defaultOutfitTags>
        <li>Worker</li>
      </defaultOutfitTags>
      <canBeDesiredForIdeo>false</canBeDesiredForIdeo>
    </apparel>
    <colorGenerator Class="ColorGenerator_Options">
      <options>
        <li>
          <weight>10</weight>
          <only>(0.33,0.33,0.33)</only>
        </li>
        <li>
          <weight>10</weight>
          <only>(0.65,0.65,0.65)</only>
        </li>
        <li>
          <weight>30</weight>
          <only>(0.4,0.3,0.15)</only>
        </li>
        <li>
          <weight>6</weight>
          <min>(0.3,0.3,0.3)</min>
          <max>(0.5,0.5,0.5)</max>
        </li>
        <li>
          <weight>2</weight>
          <min>(0.5,0.5,0.5)</min>
          <max>(1,1,1)</max>
        </li>
      </options>
    </colorGenerator>
    <tradeTags>
      <li>BasicClothing</li>
    </tradeTags>
    <!-- 套装件：装备/卸下时把 RK_LiuSet 的进度 +1 / -1。 -->
    <comps>
      <li Class="XIYUNTE.CompProperties_LiuPiece" />
    </comps>
  </ThingDef>

</Defs>
