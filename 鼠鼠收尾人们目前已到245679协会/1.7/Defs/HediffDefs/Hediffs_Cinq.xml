<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <!-- Cinq套装进度：三件衣物共用此Hediff，severity为1/3、2/3、3/3。 -->
  <HediffDef>
    <defName>RK_CinqSet</defName>
    <label>Cinq Association Set</label>
    <defaultLabelColor>(0.32,0.43,0.69)</defaultLabelColor>
    <description>Plume, suit and cape all in place; only one opponent remains at the tip of the blade.\nWearing all three Southern Cinq Association uniform pieces grants the Declared Duel ability.</description>
    <hediffClass>HediffWithComps</hediffClass>
    <isBad>false</isBad>
    <scenarioCanAdd>false</scenarioCanAdd>
    <tendable>false</tendable>
    <everCurableByItem>false</everCurableByItem>
    <initialSeverity>1</initialSeverity>
    <maxSeverity>3</maxSeverity>
    <stages>
      <li>
        <minSeverity>1</minSeverity>
        <label>1/3</label>
        <overrideTooltip>Only one Cinq Association uniform piece is worn; the set is incomplete.</overrideTooltip>
      </li>
      <li>
        <minSeverity>2</minSeverity>
        <label>2/3</label>
        <overrideTooltip>Two Cinq Association uniform pieces are worn; the set is still incomplete.</overrideTooltip>
      </li>
      <li>
        <minSeverity>3</minSeverity>
        <label>3/3</label>
        <overrideTooltip>The full Cinq Association set is worn; Declared Duel is available.</overrideTooltip>
      </li>
    </stages>
  </HediffDef>

  <!-- 主动技能的自身战斗状态：意识加成与攻击叠层均由此状态提供。 -->
  <HediffDef>
    <defName>RK_Cinq_DuelDeclarationActive</defName>
    <label>Declared Duel</label>
    <defaultLabelColor>(0.32,0.43,0.69)</defaultLabelColor>
    <description>The alley narrows; courtesy handles the retreat, and the blade handles resolve.\nEach melee attack grants 1 stack of Duel Tempo, up to 4 stacks; each stack reduces melee cooldown by 10%.</description>
    <hediffClass>HediffWithComps</hediffClass>
    <isBad>false</isBad>
    <scenarioCanAdd>false</scenarioCanAdd>
    <tendable>false</tendable>
    <everCurableByItem>false</everCurableByItem>
    <initialSeverity>1</initialSeverity>
    <maxSeverity>5</maxSeverity>
    <stages>
      <li>
        <minSeverity>1</minSeverity>
        <capMods>
          <li>
            <capacity>Consciousness</capacity>
            <offset>0.15</offset>
          </li>
        </capMods>
        <statFactorsBySeverity>
          <li>
            <stat>MeleeWeapon_CooldownMultiplier</stat>
            <valueBySeverity>
              <points>
                <li>(1,1)</li>
                <li>(2,0.9)</li>
                <li>(3,0.8)</li>
                <li>(4,0.7)</li>
                <li>(5,0.6)</li>
              </points>
            </valueBySeverity>
          </li>
        </statFactorsBySeverity>
      </li>
    </stages>
    <comps>
      <li Class="HediffCompProperties_Disappears">
        <disappearsAfterTicks>12500</disappearsAfterTicks>
        <showRemainingTime>true</showRemainingTime>
      </li>
      <li Class="HediffCompProperties_DisappearsOnDeath" />
      <li Class="XIYUNTE.HediffCompProperties_CinqDuelDeclaration" />
    </comps>
  </HediffDef>
</Defs>
