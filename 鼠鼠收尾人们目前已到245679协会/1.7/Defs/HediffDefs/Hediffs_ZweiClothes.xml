<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <!-- 二协会套装状态：severity = 已穿戴件数(1 = 1/2，2 = 2/2)。
       进度由内衬(zweiA)与外衣(zweiB)上的 XIYUNTE.CompProperties_SetPiece 在装备/卸下时维护，
       不扫描装备；Hediff 随存档保存，因此读档后进度不变。
       集齐两件时套装件组件授予技能 zwei_Aura；本 Hediff 自身不提供属性。 -->
  <HediffDef>
    <defName>zweiSet</defName>
    <label>Zwei Association Set</label>
    <description>Full Zwei Association uniform set state.\nWearing both the inner shirt and outer coat grants the Zwei Association Aura ability.</description>
    <defaultLabelColor>(250,210,93)</defaultLabelColor>
    <isBad>false</isBad>
    <scenarioCanAdd>false</scenarioCanAdd>
    <tendable>false</tendable>
    <everCurableByItem>false</everCurableByItem>
    <initialSeverity>1</initialSeverity>
    <maxSeverity>2</maxSeverity>
    <stages>
      <li>
        <minSeverity>0</minSeverity>
        <label>1/2</label>
        <overrideTooltip>Only one Zwei Association uniform piece is worn; the set is incomplete.</overrideTooltip>
      </li>
      <li>
        <minSeverity>2</minSeverity>
        <label>2/2</label>
        <overrideTooltip>The full Zwei Association set is worn; Zwei Association Aura granted.</overrideTooltip>
      </li>
    </stages>
  </HediffDef>

  <!-- 南部2协会大衣：装备时由 XIYUNTE.CompProperties_EquippedHediff 挂载，卸下时移除。
       承伤系数取 80%：IncomingDamageFactor 基础值 1，statFactors 按倍率相乘，
       因此与其他修改该 Stat 的来源为乘算组合。 -->
  <HediffDef>
    <defName>zweiB_Coat</defName>
    <label>Zwei Association - Coat</label>
    <description>Your shield.</description>
    <defaultLabelColor>(250,210,93)</defaultLabelColor>
    <isBad>false</isBad>
    <scenarioCanAdd>false</scenarioCanAdd>
    <tendable>false</tendable>
    <everCurableByItem>false</everCurableByItem>
    <initialSeverity>1</initialSeverity>
    <maxSeverity>1</maxSeverity>
    <stages>
      <li>
        <minSeverity>1</minSeverity>
        <statFactors>
          <IncomingDamageFactor>0.8</IncomingDamageFactor>
        </statFactors>
      </li>
    </stages>
  </HediffDef>
</Defs>
