<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <ThingDef ParentName="BaseMeleeWeapon_Sharp_Quality">
    <defName>RK_DeliveryBox</defName>
    <thingClass>XIYUNTE.Thing_DeliveryBox</thingClass>
    <!-- 使用原版近战武器父定义提供材料、品质和基础武器属性；SYS 手持、背负与收纳接口由本定义显式配置。 -->
    <label>Delivery Box</label>
    <description>A Delivery Box used by Northern Девять Association Fixers.\nThe box can boost its output power and switch modes. Once activated, it continuously releases energy to assist in combat, and can further increase output or change modes.\nBoosting output does not necessarily guarantee your life. Do not miss the final deadline.\n[Minimum Welfare Rest Mode active. Energy supply suspended. Note. This measure is temporary. Deliver promptly.]\nThe box carries an AI assistant, "Poru(rat)dnitsa", who navigates to ensure fast delivery.\nA spatial singularity is built in, so even many items add no noticeable weight.\nUsually, though, these boxes are relics of those who came before.\n[Stage III. Warning. Delivery overdue. Entering final acceleration stage. Further delay cannot guarantee your safety.]\n"Spare me and I swear I'll finish the delivery properly! Squeak!"</description>
    <!-- 外观组件 使用 CutoutComplex 着色器 用于带透明边缘或复杂轮廓的贴图 -->
    <graphicData>
      <texPath>Weapon/Box_Core</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <shaderType>CutoutComplex</shaderType>
      <ignoreThingDrawColor>true</ignoreThingDrawColor>
    </graphicData>
    <!-- 装备偏移 -->
    <uiIconPath>Weapon/Box_Core</uiIconPath>
    <equippedAngleOffset>0</equippedAngleOffset>
    <equippedDistanceOffset>0</equippedDistanceOffset>
    <!-- 武器属性 -->
    <techLevel>Medieval</techLevel>
    <relicChance>0</relicChance>
    <statBases>
      <WorkToMake>24000</WorkToMake>
      <Mass>4</Mass>
    </statBases>
    <!-- 制作材料 -->
    <costStuffCount>120</costStuffCount>
    <stuffCategories>
      <li>Metallic</li>
    </stuffCategories>
    <costList>
      <Steel>50</Steel>
      <ComponentIndustrial>15</ComponentIndustrial>
    </costList>
    <!-- 静态 tools 使用箱体形态数据:用于通过原版"equipment has no verbs or tools"配置检查,并让武器卡显示默认形态的近战 DPS/穿透;实际攻击动词由运行时 IVerbOwner 按当前形态提供。 -->
    <tools>
      <li>
        <label>Box Corner</label>
        <capacities>
          <li>Blunt</li>
        </capacities>
        <power>15</power>
        <armorPenetration>0.15</armorPenetration>
        <cooldownTime>2.1</cooldownTime>
        <soundMeleeHit>MeleeHit_ZeusHammer</soundMeleeHit>
      </li>
      <li>
        <label>Box Face</label>
        <capacities>
          <li>Blunt</li>
        </capacities>
        <power>16</power>
        <armorPenetration>0.20</armorPenetration>
        <cooldownTime>2.5</cooldownTime>
        <soundMeleeHit>MeleeHit_ZeusHammer</soundMeleeHit>
      </li>
    </tools>

    <comps Inherit="False">
      <li Class="CompProperties_Forbiddable" />
      <li Class="CompProperties_Styleable" />
      <li>
        <compClass>CompQuality</compClass>
      </li>
      <li Class="CompProperties_Art">
        <nameMaker>NamerArtWeaponMelee</nameMaker>
        <descriptionMaker>ArtDescription_WeaponMelee</descriptionMaker>
        <minQualityForArtistic>Excellent</minQualityForArtistic>
      </li>
      <li Class="CompProperties_EquippableAbility">
        <abilityDef>RK_DeliveryBox_HighPower</abilityDef>
        <compClass>XIYUNTE.CompEquippable_MultiForm</compClass>
      </li>
      <!-- 每个形态配置原版近战 tool:容量 Blunt/Cut 匹配原版 Smash/Slash 机动(决定伤害类型),伤害/冷却/命中音效由 tool 提供;切换只替换该实例的 tool 与机动。 -->
      <li Class="XIYUNTE.Box_shift">
        <!-- 第二个武器技能(突破工具):原版 CompProperties_EquippableAbility 只支持单个 abilityDef,故由本组件额外承载。 -->
        <secondAbilityDef>RK_BreakthroughTool</secondAbilityDef>
        <modes>
          <li>
            <!-- 基础形态:钝器伤害,宙斯锤命中音效;装备者属性见本形态 equippedStatOffsets(偏移)、equippedStatFactors(倍率)与 massCapacityBonus(负重)。 -->
            <label>Delivery Box</label>
            <description>A modular Delivery Box that can switch between multiple combat forms.\nA Delivery Box used by Northern Девять Association Fixers.\nThe box can boost its output power and switch modes. Once activated, it continuously releases energy to assist in combat, and can further increase output or change modes.\nBoosting output does not necessarily guarantee your life. Do not miss the final deadline.\n[Minimum Welfare Rest Mode active. Energy supply suspended. Note. This measure is temporary. Deliver promptly.]\nThe box carries an AI assistant, "Poru(rat)dnitsa", who navigates to ensure fast delivery.\nA spatial singularity is built in, so even many items add no noticeable weight.\nUsually, though, these boxes are relics of those who came before.\n[Stage III. Warning. Delivery overdue. Entering final acceleration stage. Further delay cannot guarantee your safety.]\n"Spare me and I swear I'll finish the delivery properly! Squeak!"</description>
            <texPath>Weapon/Box_Core</texPath>
            <drawSize>1.0</drawSize>

            <commandIcon>Weapon/Box_Core</commandIcon>
            <sheathTexPath>Weapon/box_Full</sheathTexPath>
            <sheathGraphicMulti>true</sheathGraphicMulti>
            <switchSound>Interact_ZeusHammer</switchSound>
            
            <tools>
              <li>
                <label>Box Corner</label>
                <capacities>
                  <li>Blunt</li>
                </capacities>
                <power>15</power>
                <armorPenetration>0.15</armorPenetration>
                <cooldownTime>2.1</cooldownTime>
                <soundMeleeHit>MeleeHit_ZeusHammer</soundMeleeHit>
              </li>
              <li>
                <label>Box Face</label>
                <capacities>
                  <li>Blunt</li>
                </capacities>
                <power>16</power>
                <armorPenetration>0.20</armorPenetration>
                <cooldownTime>2.5</cooldownTime>
                <soundMeleeHit>MeleeHit_ZeusHammer</soundMeleeHit>
              </li>
            </tools>
            <!-- 形态特性:偏移为加法、倍率为乘法,分两组配置;负重加成没有对应 StatDef,由补丁读取。 -->
            <equippedStatOffsets>
              <MoveSpeed>0.45</MoveSpeed>
              <CarryingCapacity>300</CarryingCapacity>
            </equippedStatOffsets>
            <equippedStatFactors>
              <CaravanBonusSpeedFactor>2</CaravanBonusSpeedFactor>
            </equippedStatFactors>
            <massCapacityBonus>1000</massCapacityBonus>
          </li>
          <li>
            <!-- 与箱体模式不同:利器伤害,等离子剑命中音效。 -->
            <label>Disintegration Blade</label>
            <description>[Request to increase power confirmed.]</description>
            <texPath>Weapon/Box_Blade</texPath>
            <drawSize>1.0</drawSize>
            
            <commandIcon>Weapon/Box_Blade</commandIcon>
            <sheathTexPath>Weapon/Box_Blade</sheathTexPath>
            <!-- 该形态近战攻击时生成的攻击特效;四个形态的 EffecterDef 只有贴图不同。 -->
            <attackEffecter>RK_DeliveryBox_AttackEffect_Blade</attackEffecter>
            <switchSound>Interact_PlasmaSword</switchSound>

            <tools>
              <li>
                <label>Disintegration Blade Slash</label>
                <capacities>
                  <li>Cut</li>
                </capacities>
                <power>33</power>
                <armorPenetration>0.55</armorPenetration>
                <cooldownTime>3.0</cooldownTime>
                <soundMeleeHit>MeleeHit_PlasmaSword</soundMeleeHit>
              </li>
              <li>
                <label>Box Face</label>
                <capacities>
                  <li>Blunt</li>
                </capacities>
                <power>16</power>
                <armorPenetration>0.20</armorPenetration>
                <cooldownTime>2.5</cooldownTime>
                <soundMeleeHit>MeleeHit_ZeusHammer</soundMeleeHit>
              </li>
            </tools>
          </li>
          <li>
            <!-- 与箱体模式不同:多功能钝器,保留较快的攻击冷却。 -->
            <label>Multi-Tool</label>
            <description>[Hostile forces detected. Porudnitsa, initiating high-power delivery mode.]\nForm trait: each swing has a 33% chance to chain another attack, up to 3 hits.</description>
            <texPath>Weapon/Box_Tool</texPath>
            <drawSize>1.0</drawSize>
            
            <commandIcon>Weapon/Box_Tool</commandIcon>
            <sheathTexPath>Weapon/Box_Tool</sheathTexPath>
            <attackEffecter>RK_DeliveryBox_AttackEffect_Tool</attackEffecter>
            <switchSound>Interact_ZeusHammer</switchSound>

            <tools>
              <li>
                <label>Tool Shot I</label>
                <capacities>
                  <li>Stab</li>
                </capacities>
                <power>9</power>
                <armorPenetration>0.40</armorPenetration>
                <cooldownTime>1.2</cooldownTime>
                <soundMeleeHit>MeleeHit_ZeusHammer</soundMeleeHit>
              </li>
              <li>
                <label>Tool Shot II</label>
                <capacities>
                  <li>Cut</li>
                </capacities>
                <power>12</power>
                <armorPenetration>0.40</armorPenetration>
                <cooldownTime>1.4</cooldownTime>
                <soundMeleeHit>MeleeHit_PlasmaSword</soundMeleeHit>
              </li>
              <li>
                <label>Tool Shot III</label>
                <capacities>
                  <li>Stab</li>
                </capacities>
                <power>8</power>
                <armorPenetration>0.30</armorPenetration>
                <cooldownTime>1.0</cooldownTime>
                <soundMeleeHit>MeleeHit_ZeusHammer</soundMeleeHit>
              </li>
            </tools>
            <!-- 形态特性:每次挥击结算后独立掷 33%,触发时本次挥击结算 3 次完整攻击。 -->
            <multiAttackChance>0.33</multiAttackChance>
            <multiAttackCount>3</multiAttackCount>
          </li>
          <li>
            <!-- 与箱体模式不同:高伤害、长冷却的重型钝器。 -->
            <label>Disintegration Hammer</label>
            <description>[Switching to hammer mode. Swing firmly in time with the vibration of the disintegration particles.]\nForm trait: 240% damage to buildings (vanilla blunt 150% plus 90%).</description>
            <texPath>Weapon/Box_Hammer</texPath>
            <drawSize>1.0</drawSize>
            
            <commandIcon>Weapon/Box_Hammer</commandIcon>
            <sheathTexPath>Weapon/Box_Hammer</sheathTexPath>
            <attackEffecter>RK_DeliveryBox_AttackEffect_Hammer</attackEffecter>
            <switchSound>Interact_ZeusHammer</switchSound>
            
            <tools>
              <li>
                <label>Disintegration Hammer Strike</label>
                <capacities>
                  <li>Blunt</li>
                </capacities>
                <power>29</power>
                <armorPenetration>0.65</armorPenetration>
                <cooldownTime>3.0</cooldownTime>
                <soundMeleeHit>MeleeHit_ZeusHammer</soundMeleeHit>
              </li>
              <li>
                <label>Box Face</label>
                <capacities>
                  <li>Blunt</li>
                </capacities>
                <power>19</power>
                <armorPenetration>0.20</armorPenetration>
                <cooldownTime>2.5</cooldownTime>
                <soundMeleeHit>MeleeHit_ZeusHammer</soundMeleeHit>
              </li>
            </tools>
            <!-- 形态特性:对建筑伤害最终倍率 = 原版钝击 1.5 + 0.9 = 2.4。 -->
            <buildingDamageFactor>2.4</buildingDamageFactor>
          </li>
          <li>
            <!-- 突破工具:重型穿透钝器 + 箱面,移动速度小幅提升。 -->
            <label>Breakthrough Tool</label>
            <description>[Warning: to improve delivery efficiency, disintegration particle limits on the courier are lifted. Execute the delivery immediately.]</description>
            <texPath>Weapon/Box_DemolitionGadget</texPath>
            <drawSize>1.0</drawSize>
            <commandIcon>Weapon/Box_DemolitionGadget</commandIcon>
            <sheathTexPath>Weapon/Box_DemolitionGadget</sheathTexPath>
            <switchSound>Interact_ZeusHammer</switchSound>
            <!-- 突破工具形态标记:突破工具技能以本标记判断当前形态能否施放。 -->
            <isBreakthroughTool>true</isBreakthroughTool>
            <attackEffecter>RK_DeliveryBox_AttackEffect_Breakthrough</attackEffecter>
            <tools>
              <li>
                <label>Breakthrough Hammer Strike</label>
                <capacities>
                  <li>Blunt</li>
                </capacities>
                <power>25</power>
                <armorPenetration>0.50</armorPenetration>
                <cooldownTime>3.0</cooldownTime>
                <soundMeleeHit>MeleeHit_ZeusHammer</soundMeleeHit>
              </li>
              <li>
                <label>Box Face</label>
                <capacities>
                  <li>Blunt</li>
                </capacities>
                <power>19</power>
                <armorPenetration>0.20</armorPenetration>
                <cooldownTime>2.5</cooldownTime>
                <soundMeleeHit>MeleeHit_ZeusHammer</soundMeleeHit>
              </li>
            </tools>
            <equippedStatOffsets>
              <MoveSpeed>0.20</MoveSpeed>
            </equippedStatOffsets>
          </li>
        </modes>
      </li>
      <li Class="SYS.CompProperties_WeaponExtention">
        <northOffset>
          <position>(0,0,0)</position>
          <angle>-90</angle>
        </northOffset>
        <southOffset>
          <position>(0,0,0)</position>
          <angle>90</angle>
        </southOffset>
        <eastOffset>
          <position>(0.3,0,-0.25)</position>
          <angle>-315</angle>
        </eastOffset>
        <westOffset>
          <position>(-0.3,0,-0.25)</position>
          <angle>-45</angle>
        </westOffset>
      </li>
      <li Class="SYS.CompProperties_Sheath">
        <sheathOnlyGraphicData>
          <texPath>RK_Texture_Empty</texPath>
          <graphicClass>Graphic_Single</graphicClass>
          <ignoreThingDrawColor>true</ignoreThingDrawColor>
        </sheathOnlyGraphicData>
        <fullGraphicData>
          <texPath>Weapon/box_Full</texPath>
          <graphicClass>Graphic_Multi</graphicClass>
          <ignoreThingDrawColor>true</ignoreThingDrawColor>
        </fullGraphicData>
        <drawPosition>Back</drawPosition>
        <northOffset>
          <position>(0,1,0)</position>
          <angle>45</angle>
        </northOffset>
        <southOffset>
          <position>(0,-1,0.1)</position>
          <angle>42</angle>
        </southOffset>
        <eastOffset>
          <position>(-0.25,-0.3,0.1)</position>
          <angle>30</angle>
        </eastOffset>
        <westOffset>
          <position>(0.25,0.3,0.1)</position>
          <angle>-30</angle>
        </westOffset>
      </li>
    </comps>
    <recipeMaker>
      <!-- 父类 BaseMeleeWeapon 的 recipeUsers 为 ElectricSmithy / FueledSmithy；
           Inherit="false" 覆盖父列表，只保留机械加工台，解锁科技同步改为机械加工。 -->
      <recipeUsers Inherit="false">
        <li>TableMachining</li>
      </recipeUsers>
      <researchPrerequisite>Machining</researchPrerequisite>
      <skillRequirements>
        <Crafting>7</Crafting>
      </skillRequirements>
    </recipeMaker>
  </ThingDef>

</Defs>
