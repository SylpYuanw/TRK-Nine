<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <!-- 死之箭:补充"闪弓"次数的弹药,在机械加工台或锻造台用钢铁制作。 -->
  <ThingDef ParentName="ResourceBase">
    <defName>Bow_of_Death_Arrow</defName>
    <label>死之箭</label>
    <description>四协会为死之弓准备的箭矢。装入死之弓后可换取一次闪弓射击。</description>
    <graphicData>
      <texPath>Item/Bow_of_Death_Arrow</texPath>
      <!-- 堆叠显示:Graphic_StackCount 属于 Graphic_Collection,texPath 指向只含该物品贴图的文件夹,
           文件夹内按文件名排序取 _a/_b/_c 三张,依 stackCount 分别显示单支/两支/满堆。 -->
      <graphicClass>Graphic_StackCount</graphicClass>
      <drawSize>(2,2)</drawSize>
    </graphicData>
    <altitudeLayer>Item</altitudeLayer>
    <alwaysHaulable>true</alwaysHaulable>
    <category>Item</category>
    <comps>
      <li Class="CompProperties_Forbiddable" />
    </comps>
    <drawGUIOverlay>true</drawGUIOverlay>
    <drawerType>MapMeshOnly</drawerType>
    <pathCost>14</pathCost>
    <rotatable>false</rotatable>
    <selectable>true</selectable>
    <stackLimit>75</stackLimit>
    <orderedTakeGroup>BowOfDeath_ArrowTakeGroup</orderedTakeGroup>
    <statBases>
      <Mass>0.3</Mass>
      <MarketValue>47</MarketValue>
    </statBases>
    <thingCategories>
      <li>Manufactured</li>
    </thingCategories>
    <thingClass>ThingWithComps</thingClass>
    <useHitPoints>false</useHitPoints>
  </ThingDef>
</Defs>
